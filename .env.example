# ==============================================================================
# KONFIGURASI UTAMA PORTAL BERITA & E-TIKET BUS (PORTAL-BERITA-TIKET)
# ==============================================================================
# Salin file ini menjadi .env pada konfigurasi lokal Anda. Jangan commit file .env ke Git repo.

# ------------------------------------------------------------------------------
# 1. MODE APLIKASI (demo vs production)
# ------------------------------------------------------------------------------
# APP_MODE=demo
#   - Mengizinkan database in-memory (mock mode) jika PostgreSQL tidak aktif.
#   - Mengizinkan QRIS simulasi dan endpoint simulasi pembayaran (/simulate-success).
#   - Cookie sesi TIDAK menggunakan atribut Secure (dapat berjalan di HTTP lokal).
# APP_MODE=production
#   - WAJIB PostgreSQL aktif; menolak in-memory fallback (fail-closed).
#   - WAJIB API Key Midtrans resmi; menolak placeholder/simulasi QRIS.
#   - Cookie sesi menggunakan atribut Secure jika diakses melalui HTTPS (X-Forwarded-Proto).
#   - Endpoint simulasi pembayaran otomatis dimatikan (HTTP 404).
APP_MODE=demo

# ------------------------------------------------------------------------------
# 2. PORT & HOSTING
# ------------------------------------------------------------------------------
PORT=3000
WEB_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. KONFIGURASI PORTAL BERITA (EXPRESS + BETTER-SQLITE3)
# ------------------------------------------------------------------------------
DATA_DIR=./berita/data
ADMIN_PATH=admin
SESSION_SECRET=
OWNER_USERNAME=
OWNER_PASSWORD=

# ------------------------------------------------------------------------------
# 4. KONFIGURASI SISTEM E-TIKET (EXPRESS API & NEXT.JS)
# ------------------------------------------------------------------------------
# Database PostgreSQL untuk tiket (wajib di production)
DATABASE_URL=

# Kredensial satu akun admin tiket
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Payment Gateway (Midtrans Core API QRIS)
PAYMENT_API_BASE_URL=https://api.sandbox.midtrans.com
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Email E-Tiket (Nodemailer / SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="E-Tiket 2026 Official" <no-reply@eticket.id>
