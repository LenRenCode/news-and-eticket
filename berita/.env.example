# Port server
PORT=3000

# Path folder data portabel (relatif atau absolut)
DATA_DIR=./data

# URL path rahasia untuk panel admin (default: admin)
ADMIN_PATH=admin

# Kunci rahasia sesi
SESSION_SECRET=

# Kredensial akun Owner pertama (hanya digunakan saat inisialisasi awal)
OWNER_USERNAME=
OWNER_PASSWORD=
